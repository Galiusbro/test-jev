# Copy to .env and fill in. Never commit .env.

# NVIDIA API Catalog — free key at https://build.nvidia.com (starts with nvapi-)
NVIDIA_API_KEY=
# Fallback chains per tier (comma-separated, first = preferred). Free-tier queues
# stall at random; a model with no token in LLM_FIRST_TOKEN_TIMEOUT_S is skipped.
# Measure candidates: `uv run jev-agent bench`
MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b,openai/gpt-oss-20b
MODEL_STRONG=nvidia/nemotron-3-ultra-550b-a55b,openai/gpt-oss-20b,moonshotai/kimi-k3
MODEL_CODER=poolside/laguna-xs-2.1,nvidia/nemotron-3-ultra-550b-a55b,openai/gpt-oss-20b
# Reasoning per tier: default | on | off | low
REASONING_FAST=off
REASONING_STRONG=default
REASONING_CODER=default
LLM_FIRST_TOKEN_TIMEOUT_S=15
LLM_TOTAL_TIMEOUT_S=180

# Jev — TypeSafe API key from https://console.typesafe.ai
TYPESAFE_API_KEY=
# Alias of the latest release; pin e.g. jev-1.13.0 once thresholds are tuned.
JEV_MODEL=jev-latest

# Decisions below this confidence take the conservative branch.
JEV_MIN_CONFIDENCE=0.7
MAX_REPAIR_ATTEMPTS=3
